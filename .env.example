# --- Docker / database bootstrap ---
POSTGRES_USER=shopsense_owner
POSTGRES_PASSWORD=change_me_owner
POSTGRES_DB=shopsense
POSTGRES_PORT=5433

# Owner connection: used ONLY by setup/seed/worker scripts (owns tables, bypasses RLS)
OWNER_DATABASE_URL=postgres://shopsense_owner:change_me_owner@localhost:5433/shopsense

# Application connection: least-privilege role, subject to Row-Level Security
APP_DB_PASSWORD=change_me_app
DATABASE_URL=postgres://shopsense_app:change_me_app@localhost:5433/shopsense

# Session signing secret (any long random string)
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-chars

# Embedding model (transformers.js / ONNX, runs locally)
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
